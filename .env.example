# Simpan API key hanya di server, jangan pernah masukkan ke file frontend.
GEMINI_API_KEY=isi_api_key_anda
# Default bisa diganti jika nama model yang tersedia di akun Anda berbeda.
GEMINI_MODEL=gemini-3.5-flash-lite
# Opsional: endpoint Gemini API
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta